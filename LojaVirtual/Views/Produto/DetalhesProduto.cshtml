@using LojaVirtual.Models
@model ProdutoModel

<div class="container my-5">
    <div class="p-5 text-center bg-body-tertiary rounded-3">
        <img src="~/img/@Model.Foto" width="350px" height="350px" style="object-fit:contain" />

        <h3 class="text-body-emphasis">@Model.Nome</h3>
        <p class="col-lg-8 mx-auto fs-5 text-muted">
            <strong>Marca:</strong> @Model.Marca<br />
            <strong>Modelo:</strong> @Model.Modelo<br />
            <strong>Estoque:</strong> @Model.QuantidadeEmEstoque
        </p>

        <ul class="list-group list-group-flush">
            <li class="list-group-item" style="font-size: 30px">R$ @Model.Valor.ToString("F")</li>
        </ul>

        <form method="Post" asp-action="BaixarEstoque" asp-controller="Estoque" asp-route-id="@Model.Id" class="mt-5">
            <button type="submit" class="btn btn-outline-warning w-50">COMPRAR</button>
            <a class="btn btn-outline-info w-50 mt-3" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left-circle mx-1"></i>VOLTAR</a>
        </form>
    </div>

</div>

 
