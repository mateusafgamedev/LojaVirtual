@using LojaVirtual.DTO.LoginDto
@model LoginUsuarioDto

@{
    Layout = "_LayoutDeslogado";
}

<div class="container">
    <form asp-controller="Login" asp-action="Login" method="post">

        <div class="mb-3">
            <label class="form-label">Email:</label>
            <input type="email" class="form-control" asp-for="Email"/>
        </div>

        <div class="mb-3">
            <label class="form-label">Senha:</label>
            <input type="password" class="form-control" asp-for="Senha"/>
        </div>

        <button type="submit" class="btn btn-outline-primary">Entrar</button>

        <div class="mt-3">
            Não tem conta? <a asp-controller="Login" asp-action="EscolherCadastro">Cadastre-se</a>
        </div>
    </form>
</div>