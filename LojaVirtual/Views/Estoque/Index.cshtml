@using LojaVirtual.Models;
@model List<RegistroProdutosModel>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h2>Registros de Vendas</h2>
        @if (Model.Count() > 0)
        {
            <form asp-controller="Estoque" asp-action="GerarRelatorio">
                <button class="btn btn-success" type="submit">Gera Relatório</button>
            </form>
        }
    </div>
    <table class="table table-hover table-bordered" id="registros">
        <thead class="table-info">
            <tr>
                <th class="text-start">Nome da Categoria</th>
                <th class="text-start">Valor Total</th>
                <th class="text-start">Data da Compra</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @if (Model.Count() != 0)
                {
                    @foreach (var registro in Model)
                    {
                        <tr>
                            <td class="text-start">@registro.NomeCategoria</td>
                            <td class="text-start">R$ @registro.ValorTotal.ToString("F2")</td>
                            <td class="text-start">@registro.DataCompra.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                }
            }
        </tbody>
        <tfoot class="table-info">
            <tr>
                <th>Total de Vendas</th>
                <th></th>
                <th>R$ @Model.First().ValorTotalGeral.ToString("F2")</th>
                
            </tr>
        </tfoot>
    </table>
</div>
